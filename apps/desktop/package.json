{
  "name": "xenon-writing-desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-platform-capable Electron client for Xenon Writing, shipped for macOS on Apple silicon. Packets A-E: session state, IPC contracts, main/preload modules, job runner, synthetic fixture providers, audio intake, transcription, capture lifecycle with macOS microphone ports, and an accessible shell.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "typecheck": "tsc -p .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:e2e": "vite build -c vite.renderer.config.ts --outDir .e2e-dist --emptyOutDir && playwright test",
    "test:electron": "electron-forge package && playwright test -c playwright.electron.config.ts"
  },
  "main": ".vite/build/main.cjs",
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
