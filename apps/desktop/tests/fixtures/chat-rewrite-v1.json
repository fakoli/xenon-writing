{
  "schema": "xenon.chat-rewrite-vectors/v1",
  "note": "Fictional text only. The desktop chat-rewrite adapter (apps/desktop/src/main/providers/chatRewrite.ts) sends request bodies exactly like these, with the route identity as the model and the job ID as the Idempotency-Key, and accepts or refuses replies as each expects; a reply vector's model is the route identity it is read against. The writing pipeline's own contract test sends these requests through its chat view, checks its replies have the pipeline-synthetic shape, and checks pipelineLimits.",
  "pipelineLimits": {
    "userChars": 16000,
    "systemChars": 4000,
    "maxTokens": 8192,
    "identifierPattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
  },
  "requests": [
    {
      "name": "with-steering",
      "model": "synthetic-writing",
      "maxTokens": 512,
      "transcript": "Synthetic note: the proposal is ready for Friday.",
      "steering": "Use one sentence.",
      "body": {
        "model": "synthetic-writing",
        "stream": false,
        "temperature": 0,
        "max_tokens": 512,
        "messages": [
          {
            "role": "system",
            "content": "Rewrite the transcript. Preserve all facts, names, numbers, dates, negations and commitments. Apply the steering only when it does not change meaning. Return only the rewritten text. Do not claim personalization. Steering: Use one sentence."
          },
          {
            "role": "user",
            "content": "Synthetic note: the proposal is ready for Friday."
          }
        ]
      }
    },
    {
      "name": "empty-steering",
      "model": "synthetic-writing",
      "maxTokens": 512,
      "transcript": "Synthetic note: meet at noon.",
      "steering": "",
      "body": {
        "model": "synthetic-writing",
        "stream": false,
        "temperature": 0,
        "max_tokens": 512,
        "messages": [
          {
            "role": "system",
            "content": "Rewrite the transcript. Preserve all facts, names, numbers, dates, negations and commitments. Apply the steering only when it does not change meaning. Return only the rewritten text. Do not claim personalization. Steering: "
          },
          {
            "role": "user",
            "content": "Synthetic note: meet at noon."
          }
        ]
      }
    }
  ],
